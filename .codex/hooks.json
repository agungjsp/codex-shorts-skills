{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && node \"$root/.codex/ownership/guard.mjs\" \"$root\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
